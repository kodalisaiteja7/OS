            Return _
                "A#[" & accountName & "]" &
                ":V#[" & viewName & "]" &
                ":F#[" & SOURCE_FLOW & "]" &
                ":O#[" & SOURCE_ORIGIN & "]" &
                ":I#[" & SOURCE_IC & "]" &
                ":U1#[" & SOURCE_UD1 & "]" &
                ":U2#[" & SOURCE_UD2 & "]" &
                ":U3#[" & SOURCE_UD3 & "]" &
                ":U4#[" & SOURCE_UD4 & "]" &
                ":U5#[" & SOURCE_UD5 & "]" &
                ":U6#[" & SOURCE_UD6 & "]" &
                ":U7#[" & SOURCE_UD7 & "]" &
                ":U8#[" & SOURCE_UD8 & "]"

        End Function



        '==================================================================
        ' CALCULATE ROA
        '==================================================================

        Private Function CalculateROA(
            ByVal si As SessionInfo,
            ByVal api As FinanceRulesApi,
            ByVal label As String,
            ByVal getNumerator As NumeratorBuilder) As DataCell

            Try

                '----------------------------------------------------------
                'Current workflow / Data Unit time
                '----------------------------------------------------------

                Dim povTimeId As Integer =
                    api.Pov.Time.MemberId

                Dim currentYear As Integer =
                    api.Time.GetYearFromId(povTimeId)

                Dim currentMonth As Integer =
                    api.Time.GetPeriodNumFromId(povTimeId)


                If currentMonth <= 0 Then

                    LogMessage(
                        si,
                        label &
                        ": Could not derive current month.")

                    Return api.Data.CreateDataCellObject(
                        0D,
                        False,
                        True)

                End If


                LogValue(
                    si,
                    label,
                    "Current Month",
                    currentMonth)


                '----------------------------------------------------------
                'Business Days
                '----------------------------------------------------------

                Dim bdCtx As BusinessDayContext =
                    BuildBusinessDayContext(
                        api,
                        currentYear,
                        currentMonth)


                LogBusinessDayContext(
                    si,
                    label,
                    bdCtx)


                '----------------------------------------------------------
                'Average Monthly AUM
                '----------------------------------------------------------

                Dim dblAvgMonthlyAUM As Decimal =
                    CalculateAvgMonthlyAUM(
                        api,
                        currentMonth)


                LogValue(
                    si,
                    label,
                    "Average AUM",
                    dblAvgMonthlyAUM)


                If dblAvgMonthlyAUM = 0D Then

                    LogMessage(
                        si,
                        label &
                        ": Average Monthly AUM is zero. Returning NoData.")


                    Return api.Data.CreateDataCellObject(
                        0D,
                        False,
                        True)

                End If


                '----------------------------------------------------------
                'Step 1
                '----------------------------------------------------------

                Dim dblAdvisorySum As Decimal =
                    SumAdvisoryAccounts(api)


                LogValue(
                    si,
                    label,
                    "Advisory Sum",
                    dblAdvisorySum)


                Dim dblNumerator As Decimal =
                    getNumerator(
                        api,
                        dblAdvisorySum)


                LogValue(
                    si,
                    label,
                    "Numerator",
                    dblNumerator)


                Dim dblA As Decimal =
                    CalculateA(
                        dblNumerator,
                        dblAvgMonthlyAUM)


                LogValue(
                    si,
                    label,
                    "A",
                    dblA)


                '----------------------------------------------------------
                'Step 2
                '----------------------------------------------------------

                Dim dblB As Decimal =
                    CalculateB(
                        dblA,
                        bdCtx)


                LogValue(
                    si,
                    label,
                    "B",
                    dblB)


                '----------------------------------------------------------
                'Step 3
                '----------------------------------------------------------

                Dim dblC As Decimal =
                    CalculateC(
                        dblAdvisorySum,
                        dblAvgMonthlyAUM)


                LogValue(
                    si,
                    label,
                    "C",
                    dblC)


                '----------------------------------------------------------
                'Step 4
                '----------------------------------------------------------

                Dim dblD As Decimal =
                    CalculateD(
                        dblC,
                        bdCtx)


                LogValue(
                    si,
                    label,
                    "D",
                    dblD)


                '----------------------------------------------------------
                'Step 5
                '----------------------------------------------------------

                Dim dblROA As Decimal =
                    dblB + dblD


                LogValue(
                    si,
                    label,
                    "Final ROA",
                    dblROA)


                Return api.Data.CreateDataCellObject(
                    dblROA,
                    False,
                    False)


            Catch ex As Exception

                Throw ErrorHandler.LogWrite(
                    si,
                    New XFException(si, ex))

            End Try

        End Function



        '==================================================================
        ' NUMERATOR - STANDARD
        '==================================================================

        Private Function BuildNumerator_Standard(
            ByVal api As FinanceRulesApi,
            ByVal advisorySum As Decimal) As Decimal


            Dim dblRevenueMtM As Decimal =
                GetCellAmount(
                    api,
                    BuildSourceScript(
                        ACCT_REVENUE_MTM,
                        SOURCE_VIEW))


            Dim dblCreditsFeesMtM As Decimal =
                GetCellAmount(
                    api,
                    BuildSourceScript(
                        ACCT_CREDITS_FEES_MTM,
                        SOURCE_VIEW))


            Return _
                dblRevenueMtM +
                Math.Abs(dblCreditsFeesMtM) -
                advisorySum

        End Function



        '==================================================================
        ' NUMERATOR - MM
        '==================================================================

        Private Function BuildNumerator_MM(
            ByVal api As FinanceRulesApi,
            ByVal advisorySum As Decimal) As Decimal


            Dim dblRevenueMM As Decimal =
                GetCellAmount(
                    api,
                    BuildSourceScript(
                        ACCT_REVENUE_MM,
                        SOURCE_VIEW))


            Return _
                dblRevenueMM -
                advisorySum

        End Function



        '==================================================================
        ' AVG MONTHLY AUM
        '==================================================================

        Private Function CalculateAvgMonthlyAUM(
            ByVal api As FinanceRulesApi,
            ByVal currentMonth As Integer) As Decimal


            Dim dblYTDAUM As Decimal =
                GetCellAmount(
                    api,
                    BuildSourceScript(
                        ACCT_AUM,
                        SOURCE_VIEW))


            Return _
                SafeDivide(
                    dblYTDAUM,
                    currentMonth)

        End Function



        '==================================================================
        ' A
        '==================================================================

        Private Function CalculateA(
            ByVal numerator As Decimal,
            ByVal avgMonthlyAUM As Decimal) As Decimal

            Return _
                SafeDivide(
                    numerator,
                    avgMonthlyAUM)

        End Function



        '==================================================================
        ' B
        '==================================================================

        Private Function CalculateB(
            ByVal a As Decimal,
            ByVal bdCtx As BusinessDayContext) As Decimal


            Dim dblRatio As Decimal =
                SafeDivide(
                    bdCtx.YTDBusinessDays,
                    bdCtx.TotalAnnualBD)


            Return _
                SafeDivide(
                    a,
                    dblRatio)

        End Function



        '==================================================================
        ' C
        '==================================================================

        Private Function CalculateC(
            ByVal advisorySum As Decimal,
            ByVal avgMonthlyAUM As Decimal) As Decimal


            Return _
                SafeDivide(
                    advisorySum,
                    avgMonthlyAUM)

        End Function



        '==================================================================
        ' D
        '==================================================================

        Private Function CalculateD(
            ByVal c As Decimal,
            ByVal bdCtx As BusinessDayContext) As Decimal


            Dim dblNum As Decimal = _
                bdCtx.YTDBusinessDays -
                bdCtx.MTDBusinessDays +
                bdCtx.M12PrevYearBD


            Dim dblDenom As Decimal = _
                bdCtx.M11YTDBusinessDays +
                bdCtx.M12PrevYearBD


            Dim dblRatio As Decimal =
                SafeDivide(
                    dblNum,
                    dblDenom)


            Return _
                SafeDivide(
                    c,
                    dblRatio)

        End Function



        '==================================================================
        ' BUSINESS DAY CONTEXT
        '==================================================================

        Private Class BusinessDayContext

            Public Property TotalAnnualBD As Decimal

            Public Property YTDBusinessDays As Decimal

            Public Property MTDBusinessDays As Decimal

            Public Property M11YTDBusinessDays As Decimal

            Public Property M12PrevYearBD As Decimal

        End Class



        '==================================================================
        ' BUILD BUSINESS DAY CONTEXT
        '==================================================================

        Private Function BuildBusinessDayContext(
            ByVal api As FinanceRulesApi,
            ByVal currentYear As Integer,
            ByVal currentMonth As Integer) As BusinessDayContext


            Dim ctx As New BusinessDayContext()


            Dim monthlyBD(11) As Decimal


            For m As Integer = 1 To 12

                monthlyBD(m - 1) =
                    GetBusinessDaysForMonth(
                        api,
                        currentYear,
                        m)

            Next


            '--------------------------------------------------------------
            'Total annual BD
            '--------------------------------------------------------------

            For i As Integer = 0 To 11

                ctx.TotalAnnualBD +=
                    monthlyBD(i)

            Next


            '--------------------------------------------------------------
            'YTD BD
            '--------------------------------------------------------------

            For i As Integer = 0 To currentMonth - 1

                ctx.YTDBusinessDays +=
                    monthlyBD(i)

            Next


            '--------------------------------------------------------------
            'MTD BD
            '--------------------------------------------------------------

            ctx.MTDBusinessDays =
                monthlyBD(currentMonth - 1)


            '--------------------------------------------------------------
            'M1-M11 YTD
            '--------------------------------------------------------------

            For i As Integer = 0 To 10

                ctx.M11YTDBusinessDays +=
                    monthlyBD(i)

            Next


            '--------------------------------------------------------------
            'Previous Year M12
            '--------------------------------------------------------------

            ctx.M12PrevYearBD =
                GetBusinessDaysForMonth(
                    api,
                    currentYear - 1,
                    12)


            Return ctx

        End Function



        '==================================================================
        ' BUSINESS DAYS
        '
        ' IMPORTANT:
        '
        ' Cube token is Cb#
        ' Consolidation token is C#
        '==================================================================

        Private Function GetBusinessDaysForMonth(
            ByVal api As FinanceRulesApi,
            ByVal year As Integer,
            ByVal month As Integer) As Decimal


            Dim sTime As String = _
                year.ToString() &
                "M" &
                month.ToString()


            Dim sScript As String = _
                "Cb#[" & BD_CUBE & "]" &
                ":E#[" & BD_ENTITY & "]" &
                ":P#[" & BD_PARENT & "]" &
                ":C#[" & BD_CONS & "]" &
                ":S#[" & BD_SCENARIO & "]" &
                ":T#[" & sTime & "]" &
                ":V#[" & BD_VIEW & "]" &
                ":A#[" & BD_ACCOUNT & "]" &
                ":F#[" & BD_FLOW & "]" &
                ":O#[" & BD_ORIGIN & "]" &
                ":I#[" & BD_IC & "]" &
                ":U1#[" & BD_UD1 & "]" &
                ":U2#[" & BD_UD2 & "]" &
                ":U3#[" & BD_UD3 & "]" &
                ":U4#[" & BD_UD4 & "]" &
                ":U5#[" & BD_UD5 & "]" &
                ":U6#[" & BD_UD6 & "]" &
                ":U7#[" & BD_UD7 & "]" &
                ":U8#[" & BD_UD8 & "]"


            Return _
                GetCellAmount(
                    api,
                    sScript)

        End Function



        '==================================================================
        ' ADVISORY ACCOUNTS
        '==================================================================

        Private Function SumAdvisoryAccounts(
            ByVal api As FinanceRulesApi) As Decimal


            Dim total As Decimal = 0D


            For Each sAcct As String In ADVISORY_ACCOUNTS

                total +=
                    GetCellAmount(
                        api,
                        BuildSourceScript(
                            sAcct,
                            SOURCE_VIEW))

            Next


            Return total

        End Function



        '==================================================================
        ' SAFE DIVIDE
        '==================================================================

        Private Function SafeDivide(
            ByVal numerator As Decimal,
            ByVal denominator As Decimal) As Decimal


            If denominator = 0D Then
                Return 0D
            End If


            Return _
                numerator /
                denominator

        End Function



        '==================================================================
        ' GET DATA CELL
        '
        ' IMPORTANT:
        '
        ' Unlike the old code, exceptions are NOT swallowed.
        '
        ' If a Member Script is invalid, the DM process should fail rather
        ' than silently writing an incorrect zero ROA.
        '==================================================================

        Private Function GetCellAmount(
            ByVal api As FinanceRulesApi,
            ByVal memberScript As String) As Decimal


            Dim oCell As DataCell =
                api.Data.GetDataCell(
                    memberScript)


            If oCell Is Nothing Then
                Return 0D
            End If


            If oCell.CellStatus.IsNoData Then
                Return 0D
            End If


            Return _
                oCell.CellAmount

        End Function



