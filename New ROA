        '==================================================================
        ' MAIN
        '==================================================================

        Public Function Main(
            ByVal si As SessionInfo,
            ByVal globals As BRGlobals,
            ByVal api As FinanceRulesApi,
            ByVal args As FinanceRulesArgs) As Object

            Try

                Select Case api.FunctionType


                    '======================================================
                    ' EXISTING DYNAMIC CUBEVIEW FUNCTIONS
                    '======================================================

                    Case FinanceFunctionType.DataCell

                        Dim sFunc As String =
                            args.DataCellArgs.FunctionName


                        If sFunc.XFEqualsIgnoreCase("GetROA") Then

                            Return CalculateROA(
                                si,
                                api,
                                "ROA",
                                AddressOf BuildNumerator_Standard)

                        End If


                        If sFunc.XFEqualsIgnoreCase("GetROA_MM") Then

                            Return CalculateROA(
                                si,
                                api,
                                "ROA_MM",
                                AddressOf BuildNumerator_MM)

                        End If



                    '======================================================
                    ' NEW DATA MANAGEMENT CUSTOM CALCULATE
                    '======================================================

                    Case FinanceFunctionType.CustomCalculate

                        Dim sFunc As String =
                            args.CustomCalculateArgs.FunctionName


                        '--------------------------------------------------
                        'Validate the Data Unit coming from DM
                        '--------------------------------------------------

                        ValidateCustomCalculatePOV(
                            si,
                            api)


                        '--------------------------------------------------
                        'Standard ROA
                        '--------------------------------------------------

                        If sFunc.XFEqualsIgnoreCase("StoreROA") Then

                            StoreROAForCurrentDataUnit(
                                si,
                                api,
                                "ROA",
                                AddressOf BuildNumerator_Standard,
                                TARGET_ROA_ACCOUNT)

                            Return Nothing

                        End If


                        '--------------------------------------------------
                        'MM ROA
                        '--------------------------------------------------

                        If sFunc.XFEqualsIgnoreCase("StoreROA_MM") Then

                            StoreROAForCurrentDataUnit(
                                si,
                                api,
                                "ROA_MM",
                                AddressOf BuildNumerator_MM,
                                TARGET_ROA_MM_ACCOUNT)

                            Return Nothing

                        End If


                End Select


                Return Nothing


            Catch ex As Exception

                Throw ErrorHandler.LogWrite(
                    si,
                    New XFException(si, ex))

            End Try

        End Function



        '==================================================================
        ' VALIDATE CUSTOM CALCULATE DATA UNIT
        '==================================================================

        Private Sub ValidateCustomCalculatePOV(
            ByVal si As SessionInfo,
            ByVal api As FinanceRulesApi)

            If Not api.Pov.Cube.Name.XFEqualsIgnoreCase(
                EXPECTED_CUBE) Then

                Throw New Exception(
                    "ROA Store: Expected Cube '" &
                    EXPECTED_CUBE &
                    "' but received '" &
                    api.Pov.Cube.Name &
                    "'.")

            End If


            If Not api.Pov.Cons.Name.XFEqualsIgnoreCase(
                EXPECTED_CONS) Then

                Throw New Exception(
                    "ROA Store: Expected Consolidation '" &
                    EXPECTED_CONS &
                    "' but received '" &
                    api.Pov.Cons.Name &
                    "'.")

            End If


            LogMessage(
                si,
                "ROA Store Data Unit -> " &
                "Entity=" & api.Pov.Entity.Name &
                ", Scenario=" & api.Pov.Scenario.Name &
                ", Time=" & api.Pov.Time.Name &
                ", Cons=" & api.Pov.Cons.Name)

        End Sub



        '==================================================================
        ' STORE ROA
        '
        ' IMPORTANT:
        '
        ' There is NO Entity loop here.
        '
        ' DM Entity Filter:
        '
        '       E#us_divisions.Base
        '
        ' causes OneStream to execute this once for every Entity.
        '==================================================================

        Private Sub StoreROAForCurrentDataUnit(
            ByVal si As SessionInfo,
            ByVal api As FinanceRulesApi,
            ByVal label As String,
            ByVal getNumerator As NumeratorBuilder,
            ByVal targetAccount As String)

            Try

                Dim currentEntity As String =
                    api.Pov.Entity.Name

                Dim currentScenario As String =
                    api.Pov.Scenario.Name

                Dim currentTime As String =
                    api.Pov.Time.Name


                LogMessage(
                    si,
                    label &
                    " Store START -> Entity=" &
                    currentEntity &
                    ", Scenario=" &
                    currentScenario &
                    ", Time=" &
                    currentTime)


                '----------------------------------------------------------
                'Calculate ROA using existing calculation logic
                '----------------------------------------------------------

                Dim roaCell As DataCell =
                    CalculateROA(
                        si,
                        api,
                        label,
                        getNumerator)


                '----------------------------------------------------------
                'Build target stat-account intersection
                '----------------------------------------------------------

                Dim targetScript As String =
                    BuildTargetScript(targetAccount)


                '----------------------------------------------------------
                'If calculation produced NoData, clear old stored ROA
                'including Durable calculated data.
                '----------------------------------------------------------

                If roaCell Is Nothing OrElse
                   roaCell.CellStatus.IsNoData Then

                    LogMessage(
                        si,
                        label &
                        " Store -> NoData. Clearing " &
                        targetScript)


                    api.Data.ClearCalculatedData(
                        targetScript,
                        True,
                        True,
                        True,
                        True)


                    Exit Sub

                End If


                Dim roaValue As Decimal =
                    roaCell.CellAmount


                '----------------------------------------------------------
                'Fully qualified target dimensions mean this formula
                'writes ONE cell inside the current Data Unit.
                '
                'Entity / Scenario / Time / Cons are inherited from the
                'current DM Data Unit.
                '----------------------------------------------------------

                Dim formula As String = _
                    targetScript &
                    " = " &
                    roaValue.ToString(
                        CultureInfo.InvariantCulture)


                LogMessage(
                    si,
                    label &
                    " Store -> Entity=" &
                    currentEntity &
                    ", Value=" &
                    roaValue.ToString() &
                    ", Formula=" &
                    formula)


                '----------------------------------------------------------
                'Write as Durable calculated data
                '----------------------------------------------------------

                api.Data.Calculate(
                    formula,
                    STORE_AS_DURABLE)


                LogMessage(
                    si,
                    label &
                    " Store COMPLETE -> Entity=" &
                    currentEntity &
                    ", ROA=" &
                    roaValue.ToString())


            Catch ex As Exception

                Throw ErrorHandler.LogWrite(
                    si,
                    New XFException(si, ex))

            End Try

        End Sub



        '==================================================================
        ' BUILD TARGET STORAGE SCRIPT
