        Private Function BuildTargetScript(
            ByVal targetAccount As String) As String

            Return _
                "A#[" & targetAccount & "]" &
                ":V#[" & TARGET_VIEW & "]" &
                ":F#[" & TARGET_FLOW & "]" &
                ":O#[" & TARGET_ORIGIN & "]" &
                ":I#[" & TARGET_IC & "]" &
                ":U1#[" & TARGET_UD1 & "]" &
                ":U2#[" & TARGET_UD2 & "]" &
                ":U3#[" & TARGET_UD3 & "]" &
                ":U4#[" & TARGET_UD4 & "]" &
                ":U5#[" & TARGET_UD5 & "]" &
                ":U6#[" & TARGET_UD6 & "]" &
                ":U7#[" & TARGET_UD7 & "]" &
                ":U8#[" & TARGET_UD8 & "]"

        End Function



        '==================================================================
        ' BUILD CURRENT ENTITY / SCENARIO / TIME SOURCE SCRIPT
        '
        ' Entity
        ' Scenario
        ' Time
        ' Consolidation
        '
        ' are intentionally NOT included.
        '
