Imports System
Imports System.Globalization
Imports OneStream.Shared.Common
Imports OneStream.Shared.Engine
Imports OneStream.Finance.Engine

Namespace OneStream.BusinessRule.Finance.ROA_Calc

    Public Class MainClass

        '==============================================================
        ' SOURCE ACCOUNTS
        '==============================================================

        Private Const RevenueMtM As String = "Revenue_MtM"
        Private Const CreditsFeesMtM As String = "[Credits and Fees_MtM]"
        Private Const RevenueMM As String = "Revenues_MM"
        Private Const AUMAccount As String = "IR_AUM_AMT"

        Private Shared ReadOnly AdvisoryAccounts As String() = {
            "454276",
            "454278",
            "454279",
            "454284",
            "454285"
        }


        '==============================================================
        ' TARGET STAT ACCOUNTS
        '==============================================================

        Private Const ROAStatAccount As String = "ROA_Stat"
        Private Const ROAMMStatAccount As String = "ROA_MM_Stat"


        '==============================================================
        ' BUSINESS DAY POV
        '==============================================================

        Private Const BDAccount As String = "990050"
        Private Const BDCube As String = "MarketManagement"
        Private Const BDEntity As String = "No_Region"
        Private Const BDCons As String = "USD"
        Private Const BDScenario As String = "Assumption"
        Private Const BDView As String = "Periodic"
        Private Const BDFlow As String = "Adjustments"
        Private Const BDOrigin As String = "Forms"
        Private Const BDIC As String = "None"
        Private Const BDUD1 As String = "Total No Department"
        Private Const BDUD2 As String = "None"
        Private Const BDUD3 As String = "None"
        Private Const BDUD4 As String = "Top"
        Private Const BDUD5 As String = "None"
        Private Const BDUD6 As String = "None"
        Private Const BDUD7 As String = "None"
        Private Const BDUD8 As String = "None"


        '==============================================================
        ' MAIN
        '==============================================================

        Public Function Main(
            si As SessionInfo,
            globals As BRGlobals,
            api As FinanceRulesApi,
            args As FinanceRulesArgs
        ) As Object

            Try

                Select Case api.FunctionType

                    '======================================================
                    ' EXISTING CUBEVIEW FUNCTIONS
                    '======================================================

                    Case FinanceFunctionType.DataCell

                        Dim functionName As String = args.DataCellArgs.FunctionName

                        If functionName.XFEqualsIgnoreCase("GetROA") Then

                            Return CalculateROA(
                                si,
                                api,
                                False
                            )

                        End If


                        If functionName.XFEqualsIgnoreCase("GetROA_MM") Then

                            Return CalculateROA(
                                si,
                                api,
                                True
                            )

                        End If


                    '======================================================
                    ' DATA MANAGEMENT CUSTOM CALCULATE
                    '======================================================

                    Case FinanceFunctionType.CustomCalculate

                        Dim functionName As String =
                            args.CustomCalculateArgs.FunctionName


                        If functionName.XFEqualsIgnoreCase("StoreROA") Then

                            StoreROA(
                                si,
                                api,
                                False,
                                ROAStatAccount
                            )

                        End If


                        If functionName.XFEqualsIgnoreCase("StoreROAMM") Then

                            StoreROA(
                                si,
                                api,
                                True,
                                ROAMMStatAccount
                            )

                        End If

                End Select


                Return Nothing


            Catch ex As Exception

                Throw ErrorHandler.LogWrite(
                    si,
                    New XFException(si, ex)
                )

            End Try

        End Function


        '==============================================================
        ' STORE ROA
        '
        ' DM controls:
        '
        ' Entity
        ' Scenario
        ' Time
        ' Consolidation
        '
        ' Example:
        '
        ' Entity = E#us_divisions.Base
        ' Scenario = Workflow Scenario
        ' Time = Workflow Time
        ' Cons = Aggregated
        '==============================================================

        Private Sub StoreROA(
            si As SessionInfo,
            api As FinanceRulesApi,
            isMM As Boolean,
            targetAccount As String
        )

            Dim entityName As String = api.Pov.Entity.Name
            Dim scenarioName As String = api.Pov.Scenario.Name
            Dim timeName As String = api.Pov.Time.Name


            BRApi.ErrorLog.LogMessage(
                si,
                "ROA Store Start | Entity=" & entityName &
                " | Scenario=" & scenarioName &
                " | Time=" & timeName
            )


            Dim roaCell As DataCell =
                CalculateROA(
                    si,
                    api,
                    isMM
                )


            Dim targetScript As String =
                GetTargetScript(targetAccount)


            If roaCell Is Nothing OrElse roaCell.CellStatus.IsNoData Then

                BRApi.ErrorLog.LogMessage(
                    si,
                    "ROA Store NoData | Entity=" & entityName
                )


                api.Data.ClearCalculatedData(
                    targetScript,
                    True,
                    True,
                    True,
                    True
                )


                Exit Sub

            End If


            Dim roaValue As Decimal =
                roaCell.CellAmount


            Dim formula As String =
                targetScript &
                " = " &
                roaValue.ToString(CultureInfo.InvariantCulture)


            api.Data.Calculate(
                formula,
                True
            )


            BRApi.ErrorLog.LogMessage(
                si,
                "ROA Stored | Entity=" & entityName &
                " | Account=" & targetAccount &
                " | Value=" & roaValue.ToString()
            )

        End Sub


        '==============================================================
        ' ROA CALCULATION
        '==============================================================

        Private Function CalculateROA(
            si As SessionInfo,
            api As FinanceRulesApi,
            isMM As Boolean
        ) As DataCell


            Dim timeId As Integer =
                api.Pov.Time.MemberId


            Dim currentYear As Integer =
                api.Time.GetYearFromId(timeId)


            Dim currentMonth As Integer =
                api.Time.GetPeriodNumFromId(timeId)


            If currentMonth <= 0 Then

                Return api.Data.CreateDataCellObject(
                    0D,
                    False,
                    True
                )

            End If


            '==========================================================
            ' BUSINESS DAYS
            '==========================================================

            Dim bd As BusinessDayContext =
                GetBusinessDayContext(
                    api,
                    currentYear,
                    currentMonth
                )


            '==========================================================
            ' AUM
            '==========================================================

            Dim ytdAUM As Decimal =
                GetCellAmount(
                    api,
                    GetSourceScript(AUMAccount)
                )


            Dim averageAUM As Decimal =
                SafeDivide(
                    ytdAUM,
                    currentMonth
                )


            If averageAUM = 0D Then

                BRApi.ErrorLog.LogMessage(
                    si,
                    "ROA NoData | Entity=" &
                    api.Pov.Entity.Name &
                    " | AUM = 0"
                )


                Return api.Data.CreateDataCellObject(
                    0D,
                    False,
                    True
                )

            End If


            '==========================================================
            ' ADVISORY ACCOUNTS
            '==========================================================

            Dim advisorySum As Decimal =
                GetAdvisorySum(api)


            '==========================================================
            ' NUMERATOR
            '==========================================================

            Dim numerator As Decimal = 0D


            If isMM Then

                Dim revenueMMValue As Decimal =
                    GetCellAmount(
                        api,
                        GetSourceScript(RevenueMM)
                    )


                numerator =
                    revenueMMValue -
                    advisorySum

            Else

                Dim revenueValue As Decimal =
                    GetCellAmount(
                        api,
                        GetSourceScript(RevenueMtM)
                    )


                Dim creditsValue As Decimal =
                    GetCellAmount(
                        api,
                        GetSourceScript(CreditsFeesMtM)
                    )


                numerator =
                    revenueValue +
                    Math.Abs(creditsValue) -
                    advisorySum

            End If


            '==========================================================
            ' STEP A
            '==========================================================

            Dim a As Decimal =
                SafeDivide(
                    numerator,
                    averageAUM
                )


            '==========================================================
            ' STEP B
            '==========================================================

            Dim ytdBusinessDayRatio As Decimal =
                SafeDivide(
                    bd.YTDBusinessDays,
                    bd.TotalAnnualBD
                )


            Dim b As Decimal =
                SafeDivide(
                    a,
                    ytdBusinessDayRatio
                )


            '==========================================================
            ' STEP C
            '==========================================================

            Dim c As Decimal =
                SafeDivide(
                    advisorySum,
                    averageAUM
                )


            '==========================================================
            ' STEP D
            '==========================================================

            Dim dNumerator As Decimal =
                bd.YTDBusinessDays -
                bd.MTDBusinessDays +
                bd.M12PrevYearBD


            Dim dDenominator As Decimal =
                bd.M11YTDBusinessDays +
                bd.M12PrevYearBD


            Dim dRatio As Decimal =
                SafeDivide(
                    dNumerator,
                    dDenominator
                )


            Dim d As Decimal =
                SafeDivide(
                    c,
                    dRatio
                )


            '==========================================================
            ' FINAL ROA
            '==========================================================

            Dim roa As Decimal =
                b + d


            BRApi.ErrorLog.LogMessage(
                si,
                "ROA Calc | Entity=" & api.Pov.Entity.Name &
                " | Revenue Type=" & If(isMM, "MM", "Standard") &
                " | AUM=" & ytdAUM.ToString() &
                " | Avg AUM=" & averageAUM.ToString() &
                " | Advisory=" & advisorySum.ToString() &
                " | Numerator=" & numerator.ToString() &
                " | ROA=" & roa.ToString()
            )


            Return api.Data.CreateDataCellObject(
                roa,
                False,
                False
            )

        End Function


        '==============================================================
        ' SOURCE POV
        '
        ' THIS MATCHES YOUR CURRENT CUBEVIEW POV.
        '
        ' Entity
        ' Scenario
        ' Time
        ' Consolidation
        '
        ' come from the current DM Data Unit.
        '==============================================================

        Private Function GetSourceScript(
            accountName As String
        ) As String


            Return "A#" & accountName &
                   ":V#YTD" &
                   ":F#Total_DataType" &
                   ":O#Top" &
                   ":I#None" &
                   ":U1#Top" &
                   ":U2#None" &
                   ":U3#None" &
                   ":U4#Top" &
                   ":U5#None" &
                   ":U6#None" &
                   ":U7#None" &
                   ":U8#None"

        End Function


        '==============================================================
        ' TARGET STORAGE POV
        '
        ' These are base/writable members.
        '
        ' The value can then roll up to:
        '
        ' F#Total_DataType
        ' O#Top
        ' U1#Top
        ' U4#Top
        '
        ' in the CubeView.
        '==============================================================

        Private Function GetTargetScript(
            accountName As String
        ) As String


            Return "A#" & accountName &
                   ":V#YTD" &
                   ":F#None" &
                   ":O#Forms" &
                   ":I#None" &
                   ":U1#None" &
                   ":U2#None" &
                   ":U3#None" &
                   ":U4#None" &
                   ":U5#None" &
                   ":U6#None" &
                   ":U7#None" &
                   ":U8#None"

        End Function


        '==============================================================
        ' ADVISORY SUM
        '==============================================================

        Private Function GetAdvisorySum(
            api As FinanceRulesApi
        ) As Decimal


            Dim total As Decimal = 0D


            For Each account As String In AdvisoryAccounts

                total +=
                    GetCellAmount(
                        api,
                        GetSourceScript(account)
                    )

            Next


            Return total

        End Function


        '==============================================================
        ' BUSINESS DAY CONTEXT
        '==============================================================

        Private Class BusinessDayContext

            Public Property TotalAnnualBD As Decimal

            Public Property YTDBusinessDays As Decimal

            Public Property MTDBusinessDays As Decimal

            Public Property M11YTDBusinessDays As Decimal

            Public Property M12PrevYearBD As Decimal

        End Class


        '==============================================================
        ' GET BUSINESS DAY CONTEXT
        '==============================================================

        Private Function GetBusinessDayContext(
            api As FinanceRulesApi,
            currentYear As Integer,
            currentMonth As Integer
        ) As BusinessDayContext


            Dim result As New BusinessDayContext()

            Dim monthlyBD(11) As Decimal


            For month As Integer = 1 To 12

                monthlyBD(month - 1) =
                    GetBusinessDays(
                        api,
                        currentYear,
                        month
                    )

            Next


            For index As Integer = 0 To 11

                result.TotalAnnualBD +=
                    monthlyBD(index)

            Next


            For index As Integer = 0 To currentMonth - 1

                result.YTDBusinessDays +=
                    monthlyBD(index)

            Next


            result.MTDBusinessDays =
                monthlyBD(currentMonth - 1)


            For index As Integer = 0 To 10

                result.M11YTDBusinessDays +=
                    monthlyBD(index)

            Next


            result.M12PrevYearBD =
                GetBusinessDays(
                    api,
                    currentYear - 1,
                    12
                )


            Return result

        End Function


        '==============================================================
        ' GET BUSINESS DAYS
        '==============================================================

        Private Function GetBusinessDays(
            api As FinanceRulesApi,
            year As Integer,
            month As Integer
        ) As Decimal


            Dim timeName As String =
                year.ToString() &
                "M" &
                month.ToString()


            Dim script As String =
                "Cb#" & BDCube &
                ":E#" & BDEntity &
                ":P#None" &
                ":C#" & BDCons &
                ":S#" & BDScenario &
                ":T#" & timeName &
                ":V#" & BDView &
                ":A#" & BDAccount &
                ":F#" & BDFlow &
                ":O#" & BDOrigin &
                ":I#" & BDIC &
                ":U1#" & BDUD1 &
                ":U2#" & BDUD2 &
                ":U3#" & BDUD3 &
                ":U4#" & BDUD4 &
                ":U5#" & BDUD5 &
                ":U6#" & BDUD6 &
                ":U7#" & BDUD7 &
                ":U8#" & BDUD8


            Return GetCellAmount(
                api,
                script
            )

        End Function


        '==============================================================
        ' GET CELL
        '==============================================================

        Private Function GetCellAmount(
            api As FinanceRulesApi,
            memberScript As String
        ) As Decimal


            Dim cell As DataCell =
                api.Data.GetDataCell(
                    memberScript
                )


            If cell Is Nothing Then
                Return 0D
            End If


            If cell.CellStatus.IsNoData Then
                Return 0D
            End If


            Return cell.CellAmount

        End Function


        '==============================================================
        ' SAFE DIVIDE
        '==============================================================

        Private Function SafeDivide(
            numerator As Decimal,
            denominator As Decimal
        ) As Decimal


            If denominator = 0D Then
                Return 0D
            End If


            Return numerator / denominator

        End Function

    End Class

End Namespace
