WITH LatestFA AS
(
    SELECT
        FA_NO,
        RGN_CD,
        EmplID,

        ROW_NUMBER() OVER
        (
            PARTITION BY FA_NO
            ORDER BY [YEAR] DESC, [MONTH] DESC
        ) AS rn

    FROM XFC_FA_Map

    WHERE
        ([YEAR] * 100 + [MONTH])
        <=
        (
            TRY_CONVERT(
                INT,
                LEFT(
                    REPLACE('|!prm_FPA_Time!|', 'T#', ''),
                    4
                )
            ) * 100
            + 12
        )
),


LatestBranch AS
(
    SELECT
        [Year],
        Branch,
        Region,

        CASE

            WHEN TRY_CONVERT(
                    BIGINT,
                    NULLIF(
                        LTRIM(RTRIM(Branch)),
                        ''
                    )
                 ) IS NOT NULL

            THEN CONVERT(
                    VARCHAR(30),

                    TRY_CONVERT(
                        BIGINT,
                        NULLIF(
                            LTRIM(RTRIM(Branch)),
                            ''
                        )
                    )
                 )

            ELSE UPPER(
                    LTRIM(
                        RTRIM(Branch)
                    )
                 )

        END AS Branch_Key,


        ROW_NUMBER() OVER
        (
            PARTITION BY

                [Year],

                CASE

                    WHEN TRY_CONVERT(
                            BIGINT,
                            NULLIF(
                                LTRIM(RTRIM(Branch)),
                                ''
                            )
                         ) IS NOT NULL

                    THEN CONVERT(
                            VARCHAR(30),

                            TRY_CONVERT(
                                BIGINT,
                                NULLIF(
                                    LTRIM(RTRIM(Branch)),
                                    ''
                                )
                            )
                         )

                    ELSE UPPER(
                            LTRIM(
                                RTRIM(Branch)
                            )
                         )

                END

            ORDER BY

                CASE

                    WHEN NULLIF(
                            LTRIM(RTRIM(Region)),
                            ''
                         ) IS NOT NULL

                    THEN 0

                    ELSE 1

                END,

                Region

        ) AS rn


    FROM XFC_BranchLocation_Map


    WHERE
        NULLIF(
            LTRIM(RTRIM(Branch)),
            ''
        ) IS NOT NULL
)


SELECT TOP 5000

    CASE

        WHEN fmap.FA_NO IS NOT NULL
            THEN 'FA_PL'

        WHEN fmap.FA_NO IS NULL

             AND NULLIF(
                    LTRIM(RTRIM(jld.Operating_Unit)),
                    ''
                 ) IS NOT NULL

            THEN 'BR_PL'

        ELSE 'NO_MARKET'

    END AS PL_Type,


    jld.Fiscal_Year,
    jld.Accounting_Period,
    jld.Business_Unit,
    jld.Journal_ID,
    jld.Posted_Date,
    jld.Account,
    jld.Chartfield1,
    jld.Chartfield3,
    jld.Operating_Unit,


    COALESCE
    (
        NULLIF(
            LTRIM(RTRIM(fmap.RGN_CD)),
            ''
        ),

        NULLIF(
            LTRIM(RTRIM(bmap.Region)),
            ''
        )

    ) AS RGN_CD,


    COALESCE(
        fmap.EmplID,
        ''
    ) AS EmplID,


    jld.Monetary_Amount


FROM XFC_FPA_JLD jld


LEFT JOIN
(
    SELECT
        FA_NO,
        RGN_CD,
        EmplID

    FROM LatestFA

    WHERE rn = 1

) fmap

    ON fmap.FA_NO = jld.Chartfield1


LEFT JOIN
(
    SELECT
        [Year],
        Branch,
        Region,
        Branch_Key

    FROM LatestBranch

    WHERE rn = 1

) bmap

    ON bmap.[Year] = jld.Fiscal_Year


    AND bmap.Branch_Key =

        CASE

            WHEN TRY_CONVERT(
                    BIGINT,
                    NULLIF(
                        LTRIM(RTRIM(jld.Operating_Unit)),
                        ''
                    )
                 ) IS NOT NULL

            THEN CONVERT(
                    VARCHAR(30),

                    TRY_CONVERT(
                        BIGINT,
                        NULLIF(
                            LTRIM(RTRIM(jld.Operating_Unit)),
                            ''
                        )
                    )
                 )

            ELSE UPPER(
                    LTRIM(
                        RTRIM(jld.Operating_Unit)
                    )
                 )

        END


WHERE

    /* ========================================================
       TIME - YEAR

       2026M7 -> 2026
       ======================================================== */

    jld.Fiscal_Year =

        LEFT(
            REPLACE(
                '|!prm_FPA_Time!|',
                'T#',
                ''
            ),
            4
        )



    /* ========================================================
       VIEW

       YTD:
           2026M7 -> Periods 1 through 7

       MONTHLY:
           2026M7 -> Period 7 only
       ======================================================== */

    AND
    (
        (
            UPPER(
                LTRIM(
                    RTRIM('|!prm_FPA_View!|')
                )
            ) = 'YTD'

            AND TRY_CONVERT(
                    INT,
                    jld.Accounting_Period
                )
                BETWEEN 1 AND

                TRY_CONVERT(
                    INT,

                    SUBSTRING(
                        REPLACE(
                            '|!prm_FPA_Time!|',
                            'T#',
                            ''
                        ),

                        CHARINDEX(
                            'M',
                            REPLACE(
                                '|!prm_FPA_Time!|',
                                'T#',
                                ''
                            )
                        ) + 1,

                        2
                    )
                )
        )


        OR


        (
            UPPER(
                LTRIM(
                    RTRIM('|!prm_FPA_View!|')
                )
            ) IN ('MONTHLY', 'MONTH')

            AND TRY_CONVERT(
                    INT,
                    jld.Accounting_Period
                )
                =

                TRY_CONVERT(
                    INT,

                    SUBSTRING(
                        REPLACE(
                            '|!prm_FPA_Time!|',
                            'T#',
                            ''
                        ),

                        CHARINDEX(
                            'M',
                            REPLACE(
                                '|!prm_FPA_Time!|',
                                'T#',
                                ''
                            )
                        ) + 1,

                        2
                    )
                )
        )
    )



    /* ========================================================
       MARKET

       prm_FPA_Market example:

       73;221;27;348;230;72;163;306;379;378;14;380

       Instead of STRING_SPLIT, check exact membership using
       semicolon delimiters.

       Example:
           ;73;221;27;
       ======================================================== */

    AND CHARINDEX
    (
        ';'
        +
        COALESCE
        (
            NULLIF(
                LTRIM(RTRIM(fmap.RGN_CD)),
                ''
            ),

            NULLIF(
                LTRIM(RTRIM(bmap.Region)),
                ''
            )
        )
        +
        ';',

        ';'
        +
        '|!prm_FPA_Market!|'
        +
        ';'

    ) > 0;
